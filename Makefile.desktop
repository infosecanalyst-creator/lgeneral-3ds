# Desktop (Linux/MSYS2) test build of the same sources, for fast UI/AI iteration
# usage: make -f Makefile.desktop      -> ./lgeneral-desktop (data from ./data)
CC      ?= gcc
SRCS    := $(wildcard lgeneral/src/*.c) $(wildcard lgeneral/util/*.c)
OBJS    := $(patsubst %.c,build-desktop/%.o,$(SRCS))
CFLAGS  ?= -O2 -g
CFLAGS  += -fgnu89-inline -Wall -Wno-unused -Wno-pointer-sign -DHAVE_CONFIG_H -DINSTALLDIR=\"$(CURDIR)/data\" \
           -Ilgeneral -Ilgeneral/src -Ilgeneral/util $(shell sdl-config --cflags)
LIBS    := $(shell sdl-config --libs) -lm

ifneq ($(NOSOUND),1)
CFLAGS  += -DWITH_SOUND
LIBS    += -lSDL_mixer
endif

lgeneral-desktop: $(OBJS)
	$(CC) -o $@ $^ $(LIBS)

build-desktop/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf build-desktop lgeneral-desktop

.PHONY: clean
